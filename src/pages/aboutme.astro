---
// Fully self-contained, independent page.
// It intentionally imports nothing from the rest of the site (no shared layout,
// no shared styles, no shared config). Everything it needs lives in this file.

const profile = {
  name: 'Abhinav Kakku',
  role: 'Cybersecurity Professional',
  location: 'India',
  tagline: 'I break things to help build them stronger.',
  initials: 'AK',
  email: 'hello@example.com',
  links: {
    linkedin: 'https://www.linkedin.com/in/abhinavkakku/',
    github: 'https://github.com/ethicalhackx',
    twitter: 'https://twitter.com/ethicalhackx',
  },
};

const stats = [
  { value: '10+', label: 'Years in Security' },
  { value: '100+', label: 'Articles Published' },
  { value: '25+', label: 'Talks & Trainings' },
  { value: '50+', label: 'Labs & Writeups' },
];

const expertise = [
  {
    icon: '🎯',
    title: 'Offensive Security',
    body: 'Penetration testing, red teaming, and adversary simulation to surface real attack paths before adversaries do.',
  },
  {
    icon: '🛡️',
    title: 'Application Security',
    body: 'Secure code review, threat modeling, and web / API assessments across the modern application stack.',
  },
  {
    icon: '📡',
    title: 'SOC & Incident Response',
    body: 'Detection engineering, threat hunting, and response that reduces dwell time and contains threats fast.',
  },
  {
    icon: '☁️',
    title: 'Cloud Security',
    body: 'Hardening identity and workloads while hunting misconfigurations across AWS, Azure, and GCP.',
  },
  {
    icon: '🔬',
    title: 'Security Research',
    body: 'Digging into tools, techniques, and vulnerabilities — then sharing findings back with the community.',
  },
  {
    icon: '🎓',
    title: 'Training & Mentorship',
    body: 'Helping aspiring professionals break into security through hands-on labs, guidance, and mock interviews.',
  },
];

const skills = [
  'Penetration Testing',
  'Web App Security',
  'Burp Suite',
  'Threat Modeling',
  'Python',
  'Linux',
  'SIEM / Splunk',
  'Incident Response',
  'Malware Analysis',
  'Cloud Security',
  'OSINT',
  'Bash',
];

const timeline = [
  {
    period: '20XX — Present',
    title: 'Senior Security Engineer',
    org: 'Placeholder Organization',
    body: 'Leading offensive and application security initiatives, building detection capabilities, and mentoring the team.',
  },
  {
    period: '20XX — 20XX',
    title: 'Security Consultant',
    org: 'Placeholder Organization',
    body: 'Delivered penetration tests, security assessments, and advisory across a range of clients and industries.',
  },
  {
    period: 'Ongoing',
    title: 'Writer, Researcher & Mentor',
    org: 'Community',
    body: 'Publishing articles, building labs, and sharing knowledge to help others grow in the field.',
  },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} — About</title>
    <meta name="description" content={`${profile.name} · ${profile.role}. ${profile.tagline}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="bg" aria-hidden="true">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="grid-overlay"></div>
    </div>

    <main>
      <!-- HERO -->
      <header class="hero reveal">
        <div class="avatar">
          <span>{profile.initials}</span>
        </div>
        <p class="eyebrow"><span class="prompt">$</span> whoami</p>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role} <span class="dot">•</span> {profile.location}</p>
        <p class="tagline">{profile.tagline}</p>

        <div class="cta">
          <a class="btn btn-primary" href={profile.links.linkedin} target="_blank" rel="noopener">
            Connect on LinkedIn
          </a>
          <a class="btn btn-ghost" href={`mailto:${profile.email}`}>Get in touch</a>
        </div>

        <div class="socials">
          <a href={profile.links.github} target="_blank" rel="noopener" aria-label="GitHub">GitHub</a>
          <a href={profile.links.twitter} target="_blank" rel="noopener" aria-label="Twitter / X">Twitter</a>
          <a href={profile.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">LinkedIn</a>
        </div>
      </header>

      <!-- STATS -->
      <section class="stats reveal">
        {
          stats.map((s) => (
            <div class="stat">
              <div class="stat-value">{s.value}</div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))
        }
      </section>

      <!-- ABOUT -->
      <section class="section reveal">
        <h2 class="section-title"><span class="hash">#</span> About</h2>
        <div class="about">
          <p>
            I'm a cybersecurity practitioner who enjoys living on both sides of the fence — attacking systems to
            understand how they fail, and defending them so they don't. My work spans penetration testing, application
            security, and security operations.
          </p>
          <p>
            Beyond the day job, I care deeply about giving back to the community: writing tutorials, building hands-on
            labs, and mentoring people starting or growing their careers in security.
          </p>
        </div>
      </section>

      <!-- EXPERTISE -->
      <section class="section reveal">
        <h2 class="section-title"><span class="hash">#</span> What I do</h2>
        <div class="cards">
          {
            expertise.map((e) => (
              <article class="card">
                <div class="card-icon">{e.icon}</div>
                <h3>{e.title}</h3>
                <p>{e.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- SKILLS -->
      <section class="section reveal">
        <h2 class="section-title"><span class="hash">#</span> Toolkit</h2>
        <ul class="chips">
          {skills.map((skill) => <li>{skill}</li>)}
        </ul>
      </section>

      <!-- EXPERIENCE -->
      <section class="section reveal">
        <h2 class="section-title"><span class="hash">#</span> Experience</h2>
        <div class="timeline">
          {
            timeline.map((t) => (
              <div class="tl-item">
                <div class="tl-marker" />
                <div class="tl-body">
                  <span class="tl-period">{t.period}</span>
                  <h3>
                    {t.title} <span class="tl-org">· {t.org}</span>
                  </h3>
                  <p>{t.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- CONTACT -->
      <section class="section contact reveal">
        <h2>Let's build something secure.</h2>
        <p>Have a question, an opportunity, or just want to talk security? I'm always happy to chat.</p>
        <div class="cta">
          <a class="btn btn-primary" href={profile.links.linkedin} target="_blank" rel="noopener">
            Connect on LinkedIn
          </a>
          <a class="btn btn-ghost" href={`mailto:${profile.email}`}>Email me</a>
        </div>
      </section>

      <footer class="foot">
        <p>© {year} {profile.name}. Crafted with Astro.</p>
      </footer>
    </main>

    <style is:global>
      :root {
        --bg: #0a0b12;
        --surface: rgba(255, 255, 255, 0.04);
        --surface-strong: rgba(255, 255, 255, 0.07);
        --border: rgba(255, 255, 255, 0.09);
        --text: #e7e9f3;
        --muted: #9aa0b4;
        --accent-1: #6366f1;
        --accent-2: #22d3ee;
        --accent-3: #a855f7;
        --radius: 18px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: 'Inter', system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      /* Animated background */
      .bg {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
      }
      .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(90px);
        opacity: 0.5;
      }
      .blob-1 {
        width: 520px;
        height: 520px;
        top: -160px;
        left: -120px;
        background: radial-gradient(circle at center, var(--accent-1), transparent 70%);
        animation: float1 16s ease-in-out infinite;
      }
      .blob-2 {
        width: 480px;
        height: 480px;
        bottom: -180px;
        right: -120px;
        background: radial-gradient(circle at center, var(--accent-2), transparent 70%);
        animation: float2 20s ease-in-out infinite;
      }
      .grid-overlay {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: radial-gradient(ellipse at center, black, transparent 80%);
      }
      @keyframes float1 {
        50% {
          transform: translate(60px, 40px) scale(1.1);
        }
      }
      @keyframes float2 {
        50% {
          transform: translate(-50px, -30px) scale(1.05);
        }
      }

      main {
        max-width: 920px;
        margin: 0 auto;
        padding: clamp(3rem, 8vw, 7rem) 1.5rem 4rem;
      }

      /* Hero */
      .hero {
        text-align: center;
        margin-bottom: 4.5rem;
      }
      .avatar {
        width: 104px;
        height: 104px;
        margin: 0 auto 1.75rem;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-family: 'Sora', sans-serif;
        font-weight: 800;
        font-size: 2.1rem;
        color: #fff;
        background: linear-gradient(135deg, var(--accent-1), var(--accent-3), var(--accent-2));
        box-shadow: 0 12px 40px -8px rgba(99, 102, 241, 0.6);
        position: relative;
      }
      .avatar::after {
        content: '';
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 1px solid var(--border);
      }
      .eyebrow {
        font-family: 'JetBrains Mono', monospace;
        color: var(--muted);
        letter-spacing: 0.08em;
        font-size: 0.9rem;
        margin-bottom: 0.75rem;
      }
      .eyebrow .prompt {
        color: var(--accent-2);
      }
      h1 {
        font-family: 'Sora', sans-serif;
        font-weight: 800;
        font-size: clamp(2.4rem, 6vw, 3.6rem);
        line-height: 1.05;
        letter-spacing: -0.02em;
        background: linear-gradient(180deg, #fff, #c7cbe0);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .role {
        margin-top: 0.85rem;
        font-size: 1.15rem;
        font-weight: 500;
        color: var(--text);
      }
      .role .dot {
        color: var(--accent-2);
        margin: 0 0.35rem;
      }
      .tagline {
        margin-top: 0.5rem;
        color: var(--muted);
        font-size: 1.05rem;
      }

      .cta {
        display: flex;
        gap: 0.85rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 2rem;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.85rem 1.6rem;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.98rem;
        text-decoration: none;
        transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, border-color 0.18s ease;
        border: 1px solid transparent;
      }
      .btn-primary {
        color: #fff;
        background: linear-gradient(135deg, var(--accent-1), var(--accent-3));
        box-shadow: 0 10px 30px -10px rgba(99, 102, 241, 0.8);
      }
      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 40px -10px rgba(99, 102, 241, 0.9);
      }
      .btn-ghost {
        color: var(--text);
        background: var(--surface);
        border-color: var(--border);
      }
      .btn-ghost:hover {
        transform: translateY(-2px);
        background: var(--surface-strong);
        border-color: rgba(255, 255, 255, 0.2);
      }

      .socials {
        margin-top: 1.75rem;
        display: flex;
        gap: 1.5rem;
        justify-content: center;
      }
      .socials a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.92rem;
        position: relative;
        transition: color 0.18s ease;
      }
      .socials a::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 0;
        height: 1px;
        background: var(--accent-2);
        transition: width 0.22s ease;
      }
      .socials a:hover {
        color: var(--text);
      }
      .socials a:hover::after {
        width: 100%;
      }

      /* Stats */
      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 5rem;
      }
      .stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.4rem 1rem;
        text-align: center;
        backdrop-filter: blur(8px);
      }
      .stat-value {
        font-family: 'Sora', sans-serif;
        font-weight: 800;
        font-size: 1.9rem;
        background: linear-gradient(135deg, var(--accent-2), var(--accent-1));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .stat-label {
        color: var(--muted);
        font-size: 0.85rem;
        margin-top: 0.25rem;
      }

      /* Sections */
      .section {
        margin-bottom: 5rem;
      }
      .section-title {
        font-family: 'Sora', sans-serif;
        font-weight: 700;
        font-size: 1.5rem;
        margin-bottom: 1.75rem;
        letter-spacing: -0.01em;
      }
      .section-title .hash {
        color: var(--accent-2);
        font-family: 'JetBrains Mono', monospace;
        margin-right: 0.4rem;
      }
      .about p {
        color: var(--muted);
        font-size: 1.08rem;
        max-width: 62ch;
      }
      .about p + p {
        margin-top: 1.1rem;
      }

      /* Cards */
      .cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.1rem;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.6rem 1.4rem;
        transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
      }
      .card:hover {
        transform: translateY(-4px);
        border-color: rgba(99, 102, 241, 0.5);
        background: var(--surface-strong);
      }
      .card-icon {
        font-size: 1.7rem;
        margin-bottom: 0.8rem;
      }
      .card h3 {
        font-family: 'Sora', sans-serif;
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
      }
      .card p {
        color: var(--muted);
        font-size: 0.95rem;
      }

      /* Chips */
      .chips {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
      }
      .chips li {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        color: var(--text);
        background: var(--surface);
        border: 1px solid var(--border);
        padding: 0.5rem 0.95rem;
        border-radius: 999px;
        transition: color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
      }
      .chips li:hover {
        color: var(--accent-2);
        border-color: rgba(34, 211, 238, 0.5);
        transform: translateY(-2px);
      }

      /* Timeline */
      .timeline {
        position: relative;
        padding-left: 1.75rem;
      }
      .timeline::before {
        content: '';
        position: absolute;
        left: 5px;
        top: 6px;
        bottom: 6px;
        width: 1px;
        background: linear-gradient(180deg, var(--accent-1), var(--accent-2), transparent);
      }
      .tl-item {
        position: relative;
        padding-bottom: 2rem;
      }
      .tl-item:last-child {
        padding-bottom: 0;
      }
      .tl-marker {
        position: absolute;
        left: -1.75rem;
        top: 6px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--accent-1);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.18);
      }
      .tl-period {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: var(--accent-2);
      }
      .tl-body h3 {
        font-family: 'Sora', sans-serif;
        font-size: 1.12rem;
        font-weight: 600;
        margin: 0.25rem 0 0.4rem;
      }
      .tl-org {
        color: var(--muted);
        font-weight: 400;
        font-size: 0.95rem;
      }
      .tl-body p {
        color: var(--muted);
        font-size: 0.97rem;
        max-width: 60ch;
      }

      /* Contact */
      .contact {
        text-align: center;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: clamp(2.5rem, 6vw, 4rem) 1.5rem;
        backdrop-filter: blur(8px);
      }
      .contact h2 {
        font-family: 'Sora', sans-serif;
        font-weight: 700;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        letter-spacing: -0.01em;
      }
      .contact p {
        color: var(--muted);
        margin: 0.75rem auto 0;
        max-width: 48ch;
      }
      .contact .cta {
        margin-top: 1.75rem;
      }

      .foot {
        text-align: center;
        color: var(--muted);
        font-size: 0.85rem;
        margin-top: 4rem;
      }

      /* Reveal on scroll */
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.7s ease, transform 0.7s ease;
      }
      .reveal.is-visible {
        opacity: 1;
        transform: none;
      }

      @media (max-width: 720px) {
        .stats {
          grid-template-columns: repeat(2, 1fr);
        }
        .cards {
          grid-template-columns: 1fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .blob {
          animation: none;
        }
      }
    </style>

    <script is:inline>
      (function () {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
